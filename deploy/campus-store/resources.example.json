    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "marketing",
        "namespace": "campus-store"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "campus-marketing"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "campus-marketing"
            }
          },
          "spec": {
            "serviceAccountName": "marketing",
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/hostname": "REPLACE_WITH_NODE_NAME"
            },
            "tolerations": [
              {
                "key": "node-role.kubernetes.io/control-plane",
                "operator": "Exists",
                "effect": "NoSchedule"
              }
            ],
            "dnsConfig": {
              "options": [
                {
                  "name": "ndots",
                  "value": "1"
                }
              ]
            },
            "securityContext": {
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "runAsNonRoot": true,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "app",
                "image": "campus-store:3099e1074354",
                "imagePullPolicy": "Never",
                "env": [
                  {
                    "name": "STORE_MODE",
                    "value": "marketing"
                  },
                  {
                    "name": "STORE_KEY",
                    "value": "campus-shipping"
                  },
                  {
                    "name": "STORE_INTERNAL_TOKEN_FILE",
                    "value": "/internal/token"
                  },
                  {
                    "name": "STORE_TLS_CERT",
                    "value": "/internal/tls.crt"
                  },
                  {
                    "name": "STORE_TLS_KEY",
                    "value": "/internal/tls.key"
                  },
                  {
                    "name": "KMS_TRANSIT_URL",
                    "value": "https://kms-transit.kube-system.svc.cluster.local:8200"
                  },
                  {
                    "name": "KMS_CA_FILE",
                    "value": "/kms-ca/ca.crt"
                  },
                  {
                    "name": "KMS_TOKEN_FILE",
                    "value": "/kms-token/token"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "internal",
                    "mountPath": "/internal",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "kms-ca",
                    "mountPath": "/kms-ca",
                    "readOnly": true
                  },
                  {
                    "name": "kms-token",
                    "mountPath": "/kms-token",
                    "readOnly": true
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "20m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "160Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8443,
                    "scheme": "HTTPS"
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8443,
                    "scheme": "HTTPS"
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                }
              }
            ],
            "volumes": [
              {
                "name": "internal",
                "secret": {
                  "secretName": "store-internal",
                  "defaultMode": 288,
                  "items": [
                    {
                      "key": "token",
                      "path": "token"
                    },
                    {
                      "key": "ca.crt",
                      "path": "ca.crt"
                    },
                    {
                      "key": "tls.crt",
                      "path": "tls.crt"
                    },
                    {
                      "key": "tls.key",
                      "path": "tls.key"
                    }
                  ]
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "16Mi"
                }
              },
              {
                "name": "kms-ca",
                "configMap": {
                  "name": "kms-ca"
                }
              },
              {
                "name": "kms-token",
                "projected": {
                  "defaultMode": 288,
                  "sources": [
                    {
                      "serviceAccountToken": {
                        "path": "token",
                        "expirationSeconds": 3600,
                        "audience": "kms-system"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
