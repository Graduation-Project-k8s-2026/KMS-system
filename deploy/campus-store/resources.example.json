          "matchLabels": {
            "app": "campus-portal"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "campus-portal"
            }
          },
          "spec": {
            "serviceAccountName": "portal",
            "automountServiceAccountToken": false,
