              "options": [
                {
                  "name": "ndots",
                  "value": "1"
                }
              ]
            },
            "securityContext": {
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "runAsNonRoot": true,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "app",
                "image": "campus-store:3099e1074354",
                "imagePullPolicy": "Never",
                "env": [
                  {
                    "name": "STORE_MODE",
                    "value": "portal"
                  },
                  {
                    "name": "STORE_KEY",
                    "value": "campus-shipping"
                  },
                  {
                    "name": "STORE_INTERNAL_TOKEN_FILE",
