                    "name": "internal",
                    "mountPath": "/internal",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "public-origin",
                    "mountPath": "/public-origin",
                    "readOnly": true
                  },
                  {
                    "name": "access",
                    "mountPath": "/access",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "20m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "160Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python3",
                      "-c",
                      "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8300/healthz', timeout=2).read()"
                    ]
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "python3",
                      "-c",
