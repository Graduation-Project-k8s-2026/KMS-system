                  },
                  {
                    "name": "STORE_PORT",
                    "value": "8300"
                  },
                  {
                    "name": "STORE_ORIGIN",
                    "value": "https://public.example"
                  },
                  {
                    "name": "STORE_PREFIX",
                    "value": "/store"
                  },
                  {
                    "name": "STORE_DEMO_ACCOUNTS",
                    "value": "1"
                  },
                  {
                    "name": "STORE_REQUIRE_TAILSCALE",
                    "value": "0"
                  },
                  {
                    "name": "STORE_DB",
                    "value": "/data/orders.db"
                  },
                  {
                    "name": "STORE_WORKER_CA",
                    "value": "/internal/ca.crt"
                  },
                  {
                    "name": "STORE_ORIGIN_FILE",
                    "value": "/public-origin/origin"
                  },
                  {
                    "name": "STORE_ACCESS_PASSWORD_FILE",
                    "value": "/access/password"
                  },
                  {
                    "name": "STORE_CHECKOUT_URL",
                    "value": "https://checkout.campus-store.svc.cluster.local:8443"
                  },
                  {
                    "name": "STORE_SHIPPING_URL",
                    "value": "https://shipping.campus-store.svc.cluster.local:8443"
                  },
                  {
                    "name": "STORE_MARKETING_URL",
                    "value": "https://marketing.campus-store.svc.cluster.local:8443"
                  },
                  {
                    "name": "STORE_MIGRATION_URL",
                    "value": "https://migration.campus-store.svc.cluster.local:8443"
                  }
                ],
